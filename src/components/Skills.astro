---
import BlackholeBackground from './BlackholeBackground.astro';

const technicalGroups = [
  {
    category: 'Languages',
    skills: [
      { name: 'Python',      level: 8 },
      { name: 'JavaScript',  level: 8 },
      { name: 'TypeScript',  level: 8 },
      { name: 'SQL',         level: 8 },
      { name: 'C',           level: 7 },
      { name: 'C++',         level: 7 },
      { name: 'R',           level: 6 },
    ],
  },
  {
    category: 'Frameworks & Libraries',
    skills: [
      { name: 'Vue.js',      level: 8 },
      { name: 'TailwindCSS', level: 8 },
      { name: 'FastAPI',     level: 8 },
      { name: 'Flask',       level: 8 },
      { name: 'Node.js',     level: 7 },
    ],
  },
  {
    category: 'AI / ML & Computer Vision',
    skills: [
      { name: 'NumPy',       level: 8 },
      { name: 'Matplotlib',  level: 8 },
      { name: 'OpenCV',      level: 8 },
      { name: 'YOLO',        level: 8 },
      { name: 'MediaPipe',   level: 8 },
      { name: 'Jupyter',     level: 8 },
      { name: 'Colab',       level: 9 },
      { name: 'Seaborn',     level: 7 },
      { name: 'scikit-learn',level: 7 },
      { name: 'PyTorch',     level: 6 },
      { name: 'TensorFlow',  level: 6 },
      { name: 'Pandas',      level: 5 },
      { name: 'Hugging Face',level: 4 },
    ],
  },
  {
    category: 'Embedded & IoT',
    skills: [
      { name: 'MQTT',          level: 10 },
      { name: 'WebSockets',    level: 9 },
      { name: 'ESP32',         level: 8 },
      { name: 'Arduino',       level: 8 },
      { name: 'Raspberry Pi',  level: 7 },
      { name: 'Bluetooth BLE', level: 7 },
      { name: 'STM32',         level: 6 },
      { name: 'ESP-IDF',       level: 7 },
      { name: 'LoRaWAN',       level: 6 },
    ],
  },
  {
    category: 'Databases & Cloud',
    skills: [
      { name: 'PostgreSQL', level: 8 },
      { name: 'Docker',     level: 7 },
      { name: 'AWS',        level: 5 },
    ],
  },
  {
    category: 'Tools & Productivity',
    skills: [
      { name: 'Git',        level: 9 },
      { name: 'VS Code',    level: 9 },
      { name: 'Terminal',   level: 8 },
      { name: 'Postman',    level: 8 },
      { name: 'Windows',    level: 8 },
      { name: 'Linux',      level: 8 },
      { name: 'KiCad',      level: 8 },
      { name: 'Claude Code',level: 8 },
      { name: 'Obsidian',   level: 9 },
      { name: 'Notion',     level: 5 },
      { name: 'NotebookLM', level: 5 },
    ],
  },
  {
    category: 'Hobby Tools',
    skills: [
      { name: 'Creality',      level: 9 },
      { name: 'OrcaSlicer',    level: 9 },
      { name: 'FreeCAD',       level: 7 },
      { name: 'Canva',         level: 7 },
      { name: 'TouchDesigner', level: 5 },
    ],
  },
];

const softSkills = [
  'Negociación y gestión de expectativas',
  'Comunicación técnica y no técnica',
  'Adaptabilidad y aprendizaje continuo',
  'Pensamiento analítico',
  'Liderazgo colaborativo',
  'Capacitación y mentoring',
  'Orientación a resultados',
];

const languages = [
  { lang: 'Español', level: 'Nativo' },
  { lang: 'Inglés',  level: 'Intermedio' },
];
---
<section id="skills" class="relative px-6 md:px-12 py-24 md:py-32 border-t border-white/10 overflow-hidden">
  <BlackholeBackground />
  <div class="relative z-10 max-w-[1200px] mx-auto">

    <div class="mb-16">
      <span class="font-mono text-md uppercase tracking-[1.4px] text-white/30">— Capacidades</span>
      <h2 class="font-mono font-light text-3xl md:text-4xl text-white mt-3">Skills</h2>
    </div>

    <!-- Technical skills -->
    <div class="space-y-8 mb-16">
      {technicalGroups.map((group) => (
        <div class="grid md:grid-cols-[200px_1fr] gap-4 md:gap-8">
          <span class="font-mono text-xs uppercase tracking-[1.4px] text-white/30 pt-1">
            {group.category}
          </span>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="font-mono text-xs uppercase tracking-[1px] text-white/70 border border-white/10 hover:border-white/20 transition-colors duration-200 px-2.5 py-1">
                {skill.name}<span class="text-white/30"> | {skill.level}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="border-t border-white/10 my-12"></div>

    <!-- Soft skills + languages -->
    <div class="grid md:grid-cols-2 gap-12">

      <div>
        <span class="font-mono text-xs uppercase tracking-[1.4px] text-white/30 block mb-6">
          Habilidades Blandas
        </span>
        <div class="flex flex-wrap gap-2">
          {softSkills.map((skill) => (
            <span class="font-sans text-sm text-white/50 border border-white/10 px-3 py-1.5">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <div>
        <span class="font-mono text-xs uppercase tracking-[1.4px] text-white/30 block mb-6">
          Idiomas
        </span>
        <div class="space-y-0">
          {languages.map((item) => (
            <div class="flex items-center justify-between border-b border-white/10 py-4 last:border-0">
              <span class="font-sans text-base text-white">{item.lang}</span>
              <span class="font-mono text-xs uppercase tracking-[1px] text-white/40">{item.level}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
